# ==========================================================================
#  TechIndex – configuration d'exemple pour la PRODUCTION (serveur Linux)
# ==========================================================================
#  scripts/techindex.sh install copie ce fichier en .env (propriétaire root,
#  lisible uniquement par le groupe www-data des conteneurs : droits 640),
#  demande le nom de domaine et génère les clés et mots de passe manquants.
#  Aucune valeur réelle ne doit figurer dans ce fichier d'exemple.
#  Voir docs/deploiement-linux.md.
# ==========================================================================

APP_NAME=TechIndex
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Nom de domaine public (DNS pointant vers le serveur) et URL complète.
APP_DOMAIN=techindex.example.com
APP_URL=https://techindex.example.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_DISPLAY_TIMEZONE=Europe/Paris
APP_MAINTENANCE_DRIVER=file

# --- HTTPS ----------------------------------------------------------------------
# letsencrypt : certificat obtenu et renouvelé automatiquement (ports 80 et 443 ouverts).
# custom      : certificat fourni (placer les fichiers dans docker/certs/).
# off         : HTTP seul, si un reverse proxy assure déjà le TLS (définir TRUSTED_PROXIES).
TLS_MODE=letsencrypt
LETSENCRYPT_EMAIL=admin@example.com
# Pour TLS_MODE=custom :
#TLS_CERT_FILE=/etc/nginx/certs/fullchain.pem
#TLS_KEY_FILE=/etc/nginx/certs/privkey.pem
HTTP_PORT=80
HTTPS_PORT=443

# --- Journaux : sortie standard, collectée par Docker (rotation 5 x 10 Mo) ---------
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Base de données (réseau interne Docker uniquement) ------------------------
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=techindex
DB_USERNAME=techindex
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Mémoire allouée au cache InnoDB (environ 25 % de la RAM du serveur).
MARIADB_BUFFER_POOL=512M

# --- Sessions et sécurité --------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ABSOLUTE_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Double authentification obligatoire pour ces rôles (recommandé : tous ceux qui voient des secrets).
TWO_FACTOR_REQUIRED_ROLES=admin,manager,technician
AUTH_PASSWORD_TIMEOUT=900
PASSWORD_CHECK_PWNED=false
CSP_ENABLED=true
HSTS_ENABLED=true
TRUSTED_PROXIES=

# --- Coffre des secrets clients -----------------------------------------------------
# Générée à l'installation. À SAUVEGARDER HORS DU SERVEUR (docs/secrets-et-cles.md).
SECRETS_KEY=
SECRETS_KEY_FILE=
SECRETS_PREVIOUS_KEYS=
SECRETS_REVEAL_PER_MINUTE=20

# --- Gestionnaire de mots de passe et clés d'accès -------------------------------------
# Reverrouillage des mots de passe 5 minutes après l'ouverture (durée fixe, non configurable).
# Domaine et origines des clés d'accès. Vides = déduits d'APP_URL (recommandé).
PASSKEYS_RP_ID=
PASSKEYS_ALLOWED_ORIGINS=

# --- Fichiers ------------------------------------------------------------------------
FILESYSTEM_DISK=local
ATTACHMENTS_MAX_SIZE_KB=20480
IMPORT_MAX_SIZE_KB=10240
IMPORT_MAX_ROWS=5000
IMPORT_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=0

# --- Échéances du tableau de bord (jours) ----------------------------------------------
ALERT_WARRANTY_DAYS=60
ALERT_LICENSE_DAYS=60
ALERT_CERTIFICATE_DAYS=30
ALERT_SERVICE_DAYS=60
ALERT_END_OF_LIFE_DAYS=90

# --- Files d'attente et cache ------------------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log

# --- E-mails (récupération des comptes, invitations) ---------------------------------------
# Renseignez le serveur SMTP de votre messagerie (Microsoft 365, OVH, relais interne...).
# Test : docker compose -f compose.prod.yaml exec app php artisan techindex:mail-test vous@exemple.fr
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="techindex@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Interface ------------------------------------------------------------------------------
INERTIA_ENCRYPT_HISTORY=true
VITE_APP_NAME="${APP_NAME}"

# --- Sauvegardes ------------------------------------------------------------------------------
BACKUP_PATH=/backups
BACKUP_KEEP=14
# Sauvegarde automatique quotidienne (heure locale APP_DISPLAY_TIMEZONE, HH:MM ; vide = désactivée).
BACKUP_DAILY_AT=01:30
# Clé PUBLIQUE age (age1...) : les archives sont chiffrées pour elle. La clé
# privée correspondante est conservée hors du serveur (coffre, poste d'administration).
BACKUP_AGE_RECIPIENT=

# --- Images Docker construites localement ---------------------------------------------------
TECHINDEX_IMAGE=techindex-app
TECHINDEX_WEB_IMAGE=techindex-web
TECHINDEX_VERSION=

# --- Mises à jour ---------------------------------------------------------------------------
# Mode d'installation : l'administration indique la commande de mise à jour à lancer.
TECHINDEX_DEPLOYMENT=docker
# Recherche des nouvelles versions sur GitHub (accès sortant à github.com) ; false pour la désactiver.
UPDATE_CHECK_ENABLED=true
