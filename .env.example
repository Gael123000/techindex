# ==========================================================================
#  TechIndex — configuration d'exemple (installation locale avec Docker)
# ==========================================================================
#  Le script d'installation copie ce fichier en ".env" s'il n'existe pas,
#  puis génère les clés et mots de passe manquants. Il n'écrase jamais une
#  valeur déjà renseignée.
#
#  Ce fichier d'exemple ne contient AUCUN identifiant réel. Ne le remplissez
#  pas : modifiez uniquement votre fichier ".env", qui ne doit jamais être
#  versionné ni partagé.
#
#  Production : voir .env.production.example et docs/deploiement-linux.md.
# ==========================================================================

APP_NAME=TechIndex
APP_ENV=local
# Clé de l'application (sessions, cookies, secrets TOTP). Générée à l'installation.
APP_KEY=
APP_DEBUG=true
# URL publique de l'application (utilisée dans les e-mails et les liens).
APP_URL=http://localhost:8080
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
# Fuseau horaire d'affichage (les dates sont stockées en UTC).
APP_DISPLAY_TIMEZONE=Europe/Paris
APP_MAINTENANCE_DRIVER=file

# Ports publiés sur la machine, limités à l'interface locale 127.0.0.1.
APP_PORT=8080
MAILPIT_PORT=8025
# Accès direct à MariaDB pour le développement : désactivé par défaut.
# Lancez « .\techindex.ps1 start -ExposeDatabase » pour l'activer sur 127.0.0.1.
DB_FORWARD_PORT=3307

# --- Journaux ---------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données (service "mariadb" du réseau Docker interne) ------------
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=techindex
DB_USERNAME=techindex
# Générés à l'installation. Ne réutilisez pas un mot de passe existant.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Sessions -----------------------------------------------------------------
SESSION_DRIVER=database
# Expiration après inactivité (minutes).
SESSION_LIFETIME=120
# Durée de vie maximale d'une session, même active (minutes).
SESSION_ABSOLUTE_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true obligatoire en HTTPS (production).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# --- Sécurité des comptes ----------------------------------------------------------
# Rôles devant obligatoirement activer la double authentification
# (admin, manager, technician, reader), séparés par des virgules.
TWO_FACTOR_REQUIRED_ROLES=
# Délai de validité d'une confirmation de mot de passe pour le profil (secondes).
AUTH_PASSWORD_TIMEOUT=900
# Vérifier les nouveaux mots de passe auprès de Have I Been Pwned (accès Internet requis).
PASSWORD_CHECK_PWNED=false
# Politique de sécurité du contenu (CSP) et HSTS (HSTS uniquement en HTTPS).
CSP_ENABLED=true
HSTS_ENABLED=false
# Reverse proxy situé devant Nginx (adresses ou plages CIDR, séparées par des virgules).
TRUSTED_PROXIES=

# --- Coffre des secrets clients -------------------------------------------------
# Clé AES-256 dédiée aux secrets, DISTINCTE d'APP_KEY. Générée à l'installation
# (php artisan techindex:secrets-key). Sa perte rend les secrets illisibles :
# sauvegardez-la hors du serveur (docs/secrets-et-cles.md).
SECRETS_KEY=
# Alternative recommandée en production : chemin d'un fichier contenant la clé.
SECRETS_KEY_FILE=
# Anciennes clés acceptées en lecture pendant une rotation (séparées par des virgules).
SECRETS_PREVIOUS_KEYS=
# Durée (secondes) pendant laquelle une confirmation du mot de passe autorise la révélation.
SECRETS_REAUTH_TIMEOUT=600
# Nombre maximal de révélations / copies de secrets par minute et par utilisateur.
SECRETS_REVEAL_PER_MINUTE=20

# --- Gestionnaire de mots de passe et clés d'accès -------------------------------
# Le gestionnaire se déverrouille uniquement avec une clé d'accès (Windows Hello,
# téléphone, clé USB). Reverrouillage après inactivité, puis au bout d'une durée
# maximale (secondes).
VAULT_IDLE_TIMEOUT=300
VAULT_MAX_UNLOCK=1800
# Domaine et origines autorisés pour les clés d'accès. Vides = déduits d'APP_URL.
# Une clé d'accès est liée au domaine : changer de domaine oblige à en créer de nouvelles.
PASSKEYS_RP_ID=
PASSKEYS_ALLOWED_ORIGINS=

# --- Fichiers -------------------------------------------------------------------
FILESYSTEM_DISK=local
ATTACHMENTS_MAX_SIZE_KB=20480
IMPORT_MAX_SIZE_KB=10240
IMPORT_MAX_ROWS=5000

# --- Échéances du tableau de bord (jours) ----------------------------------------
ALERT_WARRANTY_DAYS=60
ALERT_LICENSE_DAYS=60
ALERT_CERTIFICATE_DAYS=30
ALERT_SERVICE_DAYS=60
ALERT_END_OF_LIFE_DAYS=90

# --- Files d'attente et cache ----------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log

# --- E-mails ----------------------------------------------------------------------
# Développement : Mailpit intercepte tous les messages (http://localhost:8025).
# Production : renseignez le serveur SMTP de votre messagerie (docs/administration.md).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="techindex@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Interface ------------------------------------------------------------------
# Chiffre l'historique de navigation Inertia (nécessite HTTPS ou localhost).
INERTIA_ENCRYPT_HISTORY=true
VITE_APP_NAME="${APP_NAME}"

# --- Sauvegardes ------------------------------------------------------------------
# Clé publique "age" utilisée pour chiffrer les sauvegardes (age1...). Vide =
# sauvegardes non chiffrées (déconseillé hors développement). La clé privée
# correspondante ne doit PAS être stockée sur le serveur.
BACKUP_AGE_RECIPIENT=
# Sauvegarde automatique quotidienne à l'heure indiquée (HH:MM). Vide = désactivée.
BACKUP_DAILY_AT=
BACKUP_KEEP=14
