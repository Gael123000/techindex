# ==========================================================================
#  TechIndex – configuration d'exemple pour un hébergement PLESK (sans Docker)
# ==========================================================================
#  techindex-plesk.sh install copie ce fichier en shared/.env (droits 600 :
#  lisible uniquement par l'utilisateur système de l'abonnement), demande le
#  domaine et la base de données, puis génère les clés manquantes.
#  Aucune valeur réelle ne doit figurer dans ce fichier d'exemple.
#  Voir docs/deploiement-plesk.md.
#
#  Après toute modification : ./techindex-plesk.sh reload
#  Valeur contenant des espaces, # ou $ : entourez-la d'apostrophes ('...').
# ==========================================================================

APP_NAME=TechIndex
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# URL publique complète (domaine ou sous-domaine Plesk, certificat SSL/TLS actif).
APP_URL=https://techindex.example.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_DISPLAY_TIMEZONE=Europe/Paris
APP_MAINTENANCE_DRIVER=file

# Interpréteur PHP en ligne de commande (même version que celle du site dans Plesk).
TECHINDEX_PHP=/opt/plesk/php/8.5/bin/php

# --- Journaux : fichiers quotidiens dans shared/storage/logs ---------------------
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Base de données (créée dans Plesk : Bases de données) ------------------------
DB_CONNECTION=mariadb
# « localhost » (socket) ou 127.0.0.1 (TCP), selon ce qu'indique Plesk.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Sessions et sécurité --------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ABSOLUTE_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Double authentification obligatoire pour ces rôles (recommandé : tous ceux qui voient des secrets).
TWO_FACTOR_REQUIRED_ROLES=admin,manager,technician
AUTH_PASSWORD_TIMEOUT=900
PASSWORD_CHECK_PWNED=false
CSP_ENABLED=true
HSTS_ENABLED=true
# Vide avec Plesk (nginx et Apache transmettent déjà l'adresse du client et HTTPS).
# À renseigner seulement derrière un proxy supplémentaire (Cloudflare, répartiteur...).
TRUSTED_PROXIES=

# --- Coffre des secrets clients -----------------------------------------------------
# Générée à l'installation. À SAUVEGARDER HORS DU SERVEUR (docs/secrets-et-cles.md).
SECRETS_KEY=
SECRETS_KEY_FILE=
SECRETS_PREVIOUS_KEYS=
SECRETS_REVEAL_PER_MINUTE=20

# --- Gestionnaire de mots de passe et clés d'accès -------------------------------------
# Reverrouillage des mots de passe 5 minutes après l'ouverture (durée fixe, non configurable).
# Domaine et origines des clés d'accès. Vides = déduits d'APP_URL (recommandé).
PASSKEYS_RP_ID=
PASSKEYS_ALLOWED_ORIGINS=

# --- Fichiers ------------------------------------------------------------------------
# Les limites PHP du site (Plesk : Paramètres PHP) doivent être au moins :
# upload_max_filesize = 25M et post_max_size = 26M.
FILESYSTEM_DISK=local
ATTACHMENTS_MAX_SIZE_KB=20480
IMPORT_MAX_SIZE_KB=10240
IMPORT_MAX_ROWS=5000
IMPORT_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=0

# --- Échéances du tableau de bord (jours) ----------------------------------------------
ALERT_WARRANTY_DAYS=60
ALERT_LICENSE_DAYS=60
ALERT_CERTIFICATE_DAYS=30
ALERT_SERVICE_DAYS=60
ALERT_END_OF_LIFE_DAYS=90

# --- Files d'attente et cache ------------------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
# Pas de service permanent sur Plesk : le planificateur (tâche cron « schedule:run »
# chaque minute) lance aussi le traitement de la file d'attente.
QUEUE_WORK_FROM_SCHEDULER=true
# Supérieur à la durée maximale d'un import (900 s) : une tâche longue n'est jamais relancée en double.
DB_QUEUE_RETRY_AFTER=960

# --- E-mails (récupération des comptes, invitations) ---------------------------------------
# Par exemple une boîte créée dans Plesk (Courrier) : paramètres SMTP indiqués par Plesk.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="techindex@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Interface ------------------------------------------------------------------------------
INERTIA_ENCRYPT_HISTORY=true
VITE_APP_NAME="${APP_NAME}"

# --- Sauvegardes ------------------------------------------------------------------------------
# Dossier : shared/backups du déploiement (BACKUP_PATH à laisser absent).
BACKUP_KEEP=14
# Sauvegarde automatique quotidienne (heure locale APP_DISPLAY_TIMEZONE, HH:MM ; vide = désactivée).
BACKUP_DAILY_AT=01:30
# Clé PUBLIQUE age (age1...) : les archives sont chiffrées pour elle. La clé
# privée correspondante est conservée hors du serveur (coffre, poste d'administration).
BACKUP_AGE_RECIPIENT=
# Base VIDE réservée au test de restauration (verify-backup), créée dans Plesk
# et accessible au même utilisateur : Plesk ne permet pas de créer une base temporaire.
BACKUP_VERIFY_DATABASE=
# Outils MariaDB : à renseigner seulement s'ils ne sont pas trouvés (mysqldump / mysql).
#BACKUP_MARIADB_DUMP=mariadb-dump
#BACKUP_MARIADB=mariadb

# --- Mises à jour ---------------------------------------------------------------------------
# Mode d'installation (renseigné par le script) : mises à jour depuis Administration > Mises à jour.
TECHINDEX_DEPLOYMENT=plesk
# Recherche des nouvelles versions sur GitHub (accès sortant à github.com) ; false pour la désactiver.
UPDATE_CHECK_ENABLED=true
