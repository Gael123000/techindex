#!/bin/sh
# Démarrage d'un conteneur de production (application, worker, planificateur).
# Les caches de configuration et de routes sont construits à partir du
# fichier .env monté en lecture seule.
set -eu

cd /var/www/html

if [ ! -f .env ]; then
    echo "TechIndex : fichier .env absent (monté depuis l'hôte). Arrêt." >&2
    exit 1
fi

mkdir -p storage/app/private storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs

php artisan config:cache --no-ansi -q
php artisan route:cache --no-ansi -q
php artisan view:cache --no-ansi -q
php artisan event:cache --no-ansi -q

exec "$@"
